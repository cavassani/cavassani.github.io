---
// Importa o arquivo CSS global
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Currículo - Marcelo Cavassani</title>
  <!-- Ícones FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
  <!-- Navbar Topo -->
  <div class="navbar-container">
    <nav class="top-navbar" aria-label="Navegação principal">
      <ul class="nav-links">
        <li><a href="/projetos">Projetos</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </nav>
  </div>
  <div class="page-actions">
    <button type="button" class="print-button" id="print-button">
      <i class="fa-solid fa-print" aria-hidden="true"></i>
      Imprimir currículo
    </button>
  </div>

  <div class="cv-container">
    <!-- Cabeçalho Principal -->
    <header class="header">
      <div class="header-content">
        <div class="profile-photo-wrapper">
          <img src="/foto.jpg" alt="Foto de Perfil" class="profile-photo" />
        </div>
        <div class="header-text">
          <h1>MARCELO CAVASSANI</h1>
          <h2>Desenvolvedor / Engenheiro de Computação</h2>
        </div>
      </div>
    </header>

    <!-- Barra de Contatos -->
    <div class="contact-bar">
      <div class="contact-item">
        <i class="fa-solid fa-location-dot"></i>
        <span>Alto Alegre, SP, Brasil</span>
      </div>

      <div class="contact-item">
        <i class="fa-solid fa-envelope"></i>
        <span>marceloscavassani@gmail.com</span>
      </div>

      <div class="contact-item">
        <i class="fa-brands fa-github"></i>
        <a href="https://github.com/cavassani" target="_blank" rel="noopener noreferrer">
          github.com/cavassani
        </a>
      </div>

      <div class="contact-item">
        <i class="fa-brands fa-linkedin"></i>
        <a href="https://linkedin.com/in/marcelo-sanches-cavassani-52249351/" target="_blank" rel="noopener noreferrer">
          linkedin.com/in/marcelo-sanches-cavassani/
        </a>
      </div>
    </div>

    <!-- Conteúdo Principal de Duas Colunas -->
    <main class="main-content">

      <!-- Coluna Esquerda -->
      <aside class="sidebar">

        <section class="section">
          <h3 class="section-title">PERFIL</h3>
          <p>
            Desenvolvedor de software com experiência em desenvolvimento web,
            APIs e integração de sistemas. Experiência com PHP, Java e
            tecnologias modernas de desenvolvimento, com foco em soluções
            eficientes, manutenção de sistemas e resolução de problemas.
            Atualmente cursando Engenharia de Computação e ampliando os
            conhecimentos em Python e desenvolvimento backend.
          </p>
        </section>

        <section class="section">
          <h3 class="section-title">HABILIDADES</h3>
          <ul>
            <li>Desenvolvimento Backend (PHP, Java, Python)</li>
            <li>Frameworks (Laravel, Spring Boot, Django, FastAPI)</li>
            <li>Desenvolvimento Web (HTML, CSS, JavaScript, Astro)</li>
            <li>APIs REST e Integração de Sistemas</li>
            <li>Programação Orientada a Objetos</li>
            <li>Banco de Dados e SQL</li>
            <li>Arquitetura em Camadas e MVC</li>
            <li>Git e GitHub</li>
            <li>Docker e Linux</li>
          </ul>
        </section>

        <section class="section">
          <h3 class="section-title">FORMAÇÃO</h3>
          <div class="edu-item">
            <div class="edu-left">
              <strong>Univesp</strong>
              <p>2026 – Cursando</p>
            </div>
            <div class="edu-right">Engenharia de Computação</div>
          </div>
        </section>

        <section class="section">
          <h3 class="section-title">REFERÊNCIAS</h3>
          <p>Disponíveis sob solicitação.</p>
        </section>

      </aside>

      <!-- Coluna Direita (Experiência) -->
      <section class="career-section">

        <h3 class="section-title">CARREIRA</h3>

        <article class="job-item">
          <div class="job-year">2026 - 2026</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">ANALISTA DE ENGENHARIA DE TI II</span>
              <span class="company-name">Trillia</span>
            </div>

            <p>
              Desenvolvimento e manutenção de aplicações web, automações e
              soluções para necessidades internas, utilizando tecnologias
              modernas do ecossistema web.
            </p>

            <ul>
              <li>Desenvolvimento de aplicações web e automações.</li>
              <li>Utilização de JavaScript, Astro, Git e GitHub.</li>
              <li>Desenvolvimento com foco em organização, manutenção e performance.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2021 - 2026</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">ANALISTA DE ENGENHARIA DE TI II</span>
              <span class="company-name">PDTec</span>
            </div>

            <p>
              Desenvolvimento e manutenção de sistemas, aplicações web,
              APIs e integrações entre sistemas, atuando na evolução e
              sustentação de soluções de software.
            </p>

            <ul>
              <li>Desenvolvimento de aplicações utilizando PHP e Java.</li>
              <li>Desenvolvimento e integração de APIs REST.</li>
              <li>Utilização de bancos de dados relacionais e SQL.</li>
              <li>Manutenção e evolução de sistemas existentes.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2020 - 2021</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">ANALISTA DE SISTEMAS II</span>
              <span class="company-name">Grupo GFT</span>
            </div>

            <p>
              Desenvolvimento e manutenção de sistemas, participando da
              implementação de funcionalidades, correções e integração
              entre aplicações.
            </p>

            <ul>
              <li>Desenvolvimento de aplicações web.</li>
              <li>Programação orientada a objetos.</li>
              <li>Integração entre sistemas e APIs.</li>
              <li>Versionamento de código utilizando Git.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2015 - 2017</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">DESENVOLVEDOR DE SOFTWARE JUNIOR</span>
              <span class="company-name">It Lean</span>
            </div>

            <p>
              Desenvolvimento e manutenção de aplicações web, atuando na
              implementação de funcionalidades e correções em sistemas.
            </p>

            <ul>
              <li>Desenvolvimento de aplicações web.</li>
              <li>Manutenção e correção de sistemas.</li>
              <li>Desenvolvimento utilizando PHP e JavaScript.</li>
              <li>Versionamento de código com Git.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2009 - 2010</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">TELECOMUNICADOR</span>
              <span class="company-name">Atento</span>
            </div>

            <p>
              Atendimento e suporte a clientes, atuando na resolução de
              problemas e orientação sobre produtos e serviços.
            </p>

            <ul>
              <li>Atendimento ao cliente.</li>
              <li>Identificação e resolução de problemas.</li>
              <li>Registro e acompanhamento de solicitações.</li>
            </ul>
          </div>
        </article>

      </section>
    </main>
  </div>

  <script>
    document.querySelector('#print-button')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</body>
</html>