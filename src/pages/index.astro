---
// Importa o arquivo CSS global
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Currículo - Marcelo Cavassani | Desenvolvedor Backend & Engenharia de Software</title>
  <meta name="description" content="Currículo profissional de Marcelo Cavassani - Desenvolvedor Backend com experiência em PHP, Java, Python, Node.js, Bancos de Dados (Oracle, PostgreSQL, MySQL), Suporte a Aplicações Bancárias e Engenharia de Computação." />
  
  <!-- Ícones FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Microdados Schema.org (JSON-LD) para otimização de IA de recrutamento e robôs de busca (ATS) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Marcelo Sanches Cavassani",
      "jobTitle": "Desenvolvedor Backend / Analista de Engenharia de TI",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Alto Alegre",
        "addressRegion": "SP",
        "addressCountry": "BR"
      },
      "email": "mailto:marceloscavassani@gmail.com",
      "url": "https://cavassani.github.io/",
      "sameAs": [
        "https://github.com/cavassani",
        "https://linkedin.com/in/marcelo-sanches-cavassani-52249351/"
      ],
      "almaMater": "Univesp - Universidade Virtual do Estado de São Paulo",
      "knowsAbout": [
        "Desenvolvimento Backend",
        "PHP",
        "Java",
        "Python",
        "Node.js",
        "APIs RESTful",
        "OracleDB",
        "PostgreSQL",
        "MySQL",
        "Engenharia de Computação",
        "Integração de Sistemas",
        "Aplicações Bancárias",
        "Suporte de Aplicação e Banco de Dados"
      ]
    }
  </script>
</head>
<body>
  <!-- Navbar Topo -->
  <div class="navbar-container">
    <nav class="top-navbar" aria-label="Navegação principal">
      <ul class="nav-links">
        <li><a href="/projetos">Projetos</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </nav>
  </div>
  <div class="page-actions">
    <button type="button" class="print-button" id="print-button">
      <i class="fa-solid fa-print" aria-hidden="true"></i>
      Imprimir currículo
    </button>
  </div>

  <div class="cv-container">
    <!-- Cabeçalho Principal -->
    <header class="header">
      <div class="header-content">
        <div class="profile-photo-wrapper">
          <img src="/foto.jpg" alt="Foto de Perfil de Marcelo Cavassani" class="profile-photo" />
        </div>
        <div class="header-text">
          <h1>MARCELO CAVASSANI</h1>
          <h2>Desenvolvedor Backend | Engenharia de Computação</h2>
        </div>
      </div>
    </header>

    <!-- Barra de Contatos -->
    <div class="contact-bar">
      <div class="contact-item">
        <i class="fa-solid fa-location-dot"></i>
        <span>Alto Alegre, SP, Brasil</span>
      </div>

      <div class="contact-item">
        <i class="fa-solid fa-envelope"></i>
        <a href="mailto:marceloscavassani@gmail.com">marceloscavassani@gmail.com</a>
      </div>

      <div class="contact-item">
        <i class="fa-brands fa-github"></i>
        <a href="https://github.com/cavassani" target="_blank" rel="noopener noreferrer">
          github.com/cavassani
        </a>
      </div>

      <div class="contact-item">
        <i class="fa-brands fa-linkedin"></i>
        <a href="https://linkedin.com/in/marcelo-sanches-cavassani-52249351/" target="_blank" rel="noopener noreferrer">
          linkedin.com/in/marcelo-sanches-cavassani
        </a>
      </div>
    </div>

    <!-- Conteúdo Principal de Duas Colunas -->
    <main class="main-content">

      <!-- Coluna Esquerda -->
      <aside class="sidebar">

        <section class="section">
          <h3 class="section-title">PERFIL</h3>
          <p>
            Desenvolvedor de Software com ampla experiência em desenvolvimento backend,
            construção e integração de APIs RESTful, suporte a aplicações bancárias e gerenciamento de banco de dados. Sólida atuação na criação de soluções para o mercado imobiliário e ecossistemas financeiros corporativos. Atualmente cursando Engenharia de Computação na Univesp.
          </p>
        </section>

        <section class="section">
          <h3 class="section-title">HABILIDADES</h3>
          <ul>
            <li><strong>Linguagens:</strong> PHP, Java, Python, Node.js, JavaScript</li>
            <li><strong>Bancos de Dados:</strong> OracleDB, PostgreSQL, MySQL, SQL</li>
            <li><strong>Arquitetura & APIs:</strong> APIs RESTful, Microsserviços, Integração de Sistemas, MVC</li>
            <li><strong>Sistemas & Suporte:</strong> Sustentação de Aplicações Bancárias</li>
            <li><strong>Ferramentas & DevOps:</strong> Git, GitHub, Docker, Linux</li>
            <li><strong>Engenharia de Software:</strong> Programação Orientada a Objetos (POO), Manutenção e Evolução de Código</li>
          </ul>
        </section>

        <section class="section">
          <h3 class="section-title">FORMAÇÃO ACADÊMICA</h3>
          <div class="edu-item">
            <div class="edu-left">
              <strong>Univesp</strong>
              <p>2026 – Cursando</p>
            </div>
            <div class="edu-right">Bacharelado em Engenharia de Computação</div>
          </div>
        </section>

        <section class="section">
          <h3 class="section-title">REFERÊNCIAS</h3>
          <p>Disponíveis sob solicitação.</p>
        </section>

      </aside>

      <!-- Coluna Direita (Experiência Profissional) -->
      <section class="career-section">

        <h3 class="section-title">CARREIRA PROFISSIONAL</h3>

        <article class="job-item">
          <div class="job-year">2026 - 2026</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">ANALISTA DE ENGENHARIA DE TI II</span>
              <span class="company-name">Trillia</span>
            </div>

            <p>
              Atuação em Sustentação a aplicações bancárias, garantindo a alta disponibilidade, estabilidade e segurança dos ambientes financeiros.
            </p>

            <ul>
              <li>Ssustentação focado em <strong>aplicações bancárias</strong> e ecossistemas financeiros de missão crítica.</li>
              <li>Desenvolvimento de automações web e ferramentas de apoio interno utilizando tecnologias modernas (JavaScript,Python, Git).</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2021 - 2026</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">ANALISTA DE ENGENHARIA DE TI II</span>
              <span class="company-name">PDTec</span>
            </div>

            <p>
              Desenvolvimento e arquitetura de soluções de software voltadas para o mercado imobiliário,
              atuando na criação de APIs, integrações de sistemas complexos e gestão de dados corporativos.
            </p>

            <ul>
              <li>Desenvolvimento e evolução de sistemas backend utilizando <strong>PHP, Java e Python</strong>.</li>
              <li>Criação de <strong>APIs RESTful em Node.js</strong> para viabilizar integrações entre ferramentas e parceiros externos.</li>
              <li>Modelagem, consultas avançadas e sustentação em bancos de dados <strong>OracleDB, MySQL e PostgreSQL</strong>.</li>
              <li>Manutenção preventiva/corretiva e otimização de performance em ecossistemas do setor imobiliário.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2020 - 2021</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">ANALISTA DE SISTEMAS II</span>
              <span class="company-name">Grupo GFT</span>
            </div>

            <p>
              Desenvolvimento e manutenção de sistemas corporativos, participando ativamente da implementação de novas funcionalidades, refatoração e consumo de APIs.
            </p>

            <ul>
              <li>Desenvolvimento de aplicações web aplicando padrões de Programação Orientada a Objetos.</li>
              <li>Integração entre sistemas via APIs REST e microsserviços.</li>
              <li>Versionamento de código e colaboração contínua utilizando Git/GitHub.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2015 - 2017</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">DESENVOLVEDOR DE SOFTWARE JÚNIOR</span>
              <span class="company-name">It Lean</span>
            </div>

            <p>
              Desenvolvimento e manutenção de aplicações web, atuando na implementação de funcionalidades e resolução de chamados técnicos.
            </p>

            <ul>
              <li>Desenvolvimento e sustentação de sistemas web utilizando PHP e JavaScript.</li>
              <li>Manutenção corretiva, evolução de código e consultas SQL.</li>
              <li>Controle de versão de código-fonte com Git.</li>
            </ul>
          </div>
        </article>

        <article class="job-item">
          <div class="job-year">2009 - 2010</div>

          <div class="job-details">
            <div class="job-header">
              <span class="job-title">TELECOMUNICADOR</span>
              <span class="company-name">Atento</span>
            </div>

            <p>
              Atendimento e suporte ao cliente, foco em diagnóstico ágil e resolução de problemas operacionais.
            </p>

            <ul>
              <li>Atendimento técnico e suporte direto a clientes.</li>
              <li>Identificação, análise e resolução de problemas de comunicação.</li>
            </ul>
          </div>
        </article>

      </section>
    </main>
  </div>

  <script>
    document.querySelector('#print-button')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</body>
</html>